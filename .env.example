# Local MongoDB server. Replace this value if your MongoDB uses another address.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tech_news

# GNews.io account settings. Keep the API key private in your local .env.
NEWS_API_URL=https://gnews.io/api/v4/search
NEWS_API_KEY=132cb97ef1984c1234caa36e48f0395d
NEWS_REQUEST_TIMEOUT_SECONDS=15

# The daily job runs at 6:00 AM UTC unless you change these values.
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
NEWS_SCHEDULE_TIMEZONE=UTC

APP_HOST=127.0.0.1
APP_PORT=5000
